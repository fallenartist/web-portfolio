DATABASE_URI=postgres://postgres:<password>@127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# PostHog: runtime settings, never use NEXT_PUBLIC_ for the personal API key.
POSTHOG_ENABLED=false
POSTHOG_REGION=eu
POSTHOG_PROJECT_TOKEN=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Local and development visits are excluded unless explicitly enabled for testing.
POSTHOG_TRACK_DEVELOPMENT=false
POSTHOG_TRACK_LOCALHOST=false
